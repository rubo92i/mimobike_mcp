[Unit]
Description=Mimo knowledge MCP server (documentation over MCP)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/services/mcp
EnvironmentFile=/opt/services/mcp/.env
Environment=SPRING_PROFILES_ACTIVE=prod
ExecStart=/usr/bin/java -jar /opt/services/mcp/app.jar
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-knowledge

[Install]
WantedBy=multi-user.target
