[Unit]
Description=mimobike MongoDB -> PostgreSQL sync worker
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/services/mcp
EnvironmentFile=/opt/services/mcp/.env
ExecStart=/usr/bin/node src/sync.mjs
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-sync

[Install]
WantedBy=multi-user.target
