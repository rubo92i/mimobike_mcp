# Mimo Knowledge MCP — environment template.
# Copy to .env on the host (or export in the service environment).
# Variable NAMES only — never commit real values.

# Fine-grained GitHub PAT with read-only "Contents" permission,
# scoped to exactly the repositories configured in application.yml.
GITHUB_TOKEN=

# Developer bearer tokens for POST /mcp, comma-separated "name:token" pairs.
# The name is the developer identity recorded in audit logs.
# Example FORMAT (not a real value): alice:3f9c...,bob:a81d...
MCP_AUTH_TOKENS=

# Separate bearer token for POST /internal/reload (used by GitHub Actions).
# Must be different from every developer token.
MCP_RELOAD_TOKEN=

# Optional: cache refresh interval, ISO-8601 duration between PT1M and PT5M.
KNOWLEDGE_REFRESH_INTERVAL=PT3M

# Optional: HTTP port (default 3100, matches the existing nginx upstream).
PORT=3100
