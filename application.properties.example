# Mimo knowledge MCP — external configuration template.
# Copy to /opt/services/mcp/application.properties on the host, fill in real
# values and chmod 600. The file is REQUIRED there: mcp.sh loads it via
# --spring.config.additional-location; the repository allowlist stays in the
# jar's application.yml. KEY NAMES ONLY here — never commit real values.

server.port=3100

# Fine-grained GitHub PAT, read-only "Contents" permission, scoped to
# exactly the 11 repositories configured in application.yml.
mimo.knowledge.github.token=CHANGE_ME

# Developer bearer tokens for POST /mcp: comma-separated name:token pairs.
# The name is the developer identity in audit logs.
# Generate each token with: openssl rand -hex 32
mimo.security.auth-tokens=ruben:CHANGE_ME,valodya:CHANGE_ME,marcus:CHANGE_ME,harut:CHANGE_ME

# Separate token for POST /internal/reload (= the MIMO_MCP_RELOAD_TOKEN
# Actions secret in the 11 service repositories). Must differ from every
# developer token.
mimo.security.reload-token=CHANGE_ME

# Optional: cache refresh interval, ISO-8601, clamped to PT1M..PT5M.
#mimo.knowledge.refresh-interval=PT3M

# Logging: the prod profile (activated by mcp.sh) already logs to
# /opt/log/mcp.log with rotation (100MB per file, 365 days history,
# 100GB cap, rolled files in /opt/log/mcp/). Override here only if needed:
#logging.file.name=/opt/log/mcp.log
#logging.logback.rollingpolicy.max-file-size=100MB
#logging.logback.rollingpolicy.max-history=365
#logging.logback.rollingpolicy.total-size-cap=100GB
#logging.logback.rollingpolicy.file-name-pattern=/opt/log/mcp/mcp-%d{yyyy-MM-dd}-%i.log
