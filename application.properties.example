# Mimo knowledge MCP — external configuration template.
# Copy to /opt/services/mcp/application.properties on the host and fill in
# real values. This file is loaded via --spring.config.additional-location
# (see mcp.sh); the repository allowlist stays in the jar's application.yml.
# KEY NAMES ONLY here — never commit real values.

server.port=3100

# Fine-grained GitHub PAT, read-only "Contents" permission, scoped to
# exactly the 11 repositories configured in application.yml.
mimo.knowledge.github.token=CHANGE_ME

# Developer bearer tokens for POST /mcp: comma-separated name:token pairs.
# The name is the developer identity in audit logs.
# Generate each token with: openssl rand -hex 32
mimo.security.auth-tokens=alice:CHANGE_ME,bob:CHANGE_ME

# Separate token for POST /internal/reload (used by GitHub Actions).
# Must differ from every developer token.
mimo.security.reload-token=CHANGE_ME

# Optional: cache refresh interval, ISO-8601, clamped to PT1M..PT5M.
#mimo.knowledge.refresh-interval=PT3M

# Logging: mcp.sh discards stdout, so log to a file like the other services.
logging.file.name=/opt/log/mcp.log
# Optional structured JSON logs in the file:
#logging.structured.format.file=ecs
